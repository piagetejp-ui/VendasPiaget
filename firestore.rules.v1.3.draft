rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/usuarios_auth/$(request.auth.uid)); }
    function activeInternal() { return signedIn() && userDoc().data.ativo == true; }
    function role() { return userDoc().data.perfil; }
    function admin() { return activeInternal() && (role() == 'admin' || role() == 'gestao'); }
    function secretaria() { return activeInternal() && (role() == 'admin' || role() == 'gestao' || role() == 'secretaria'); }
    function cantina() { return activeInternal() && (role() == 'admin' || role() == 'gestao' || role() == 'cantina'); }

    // PERFIS INTERNOS
    match /usuarios_auth/{uid} {
      allow read: if activeInternal() && (request.auth.uid == uid || admin());
      allow write: if admin();
    }
    match /usuarios_acesso/{id} { allow read, write: if admin(); }

    // ATENÇÃO: regras dos responsáveis ainda devem ser fechadas com backend/custom token.
    // Mantenha regras de desenvolvimento enquanto valida a V1.3.0, ou implemente APIs server-side.

    match /{document=**} {
      allow read, write: if activeInternal();
    }
  }
}
